{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://imggqlzlsvbqjnabracc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "ecosense-mcp",
      "version": "0.1.0",
      "title": "Ecosense Solutions"
    },
    "tools": [
      {
        "name": "list_blog_posts",
        "title": "Lister les articles de blog",
        "description": "Liste les articles du blog Ecosense visibles pour l'utilisateur connecté (publiés, ou tous les articles si l'utilisateur est administrateur).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filtrer par statut. 'all' réservé aux administrateurs.",
              "type": "string",
              "enum": [
                "published",
                "draft",
                "all"
              ]
            },
            "limit": {
              "description": "Nombre maximum d'articles à retourner (défaut 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_blog_post",
        "title": "Récupérer un article de blog",
        "description": "Récupère le contenu complet d'un article de blog Ecosense à partir de son slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Slug unique de l'article."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_contact_message",
        "title": "Envoyer un message de contact",
        "description": "Enregistre un nouveau message de contact pour Ecosense Solutions (nom, email, sujet, message).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "subject": {
              "type": "string",
              "maxLength": 300
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            }
          },
          "required": [
            "name",
            "email",
            "message"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_contact_messages",
        "title": "Lister les messages de contact",
        "description": "Liste les messages de contact reçus. Réservé aux administrateurs (contrôlé par les politiques RLS).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filtrer par statut (ex: 'unread').",
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
